<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/va_bg_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="44dp"
        android:paddingBottom="32dp">

        <!-- ── Header ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="2dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="VisionAgent"
                android:textSize="30sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:textColor="@color/va_text_primary"
                android:letterSpacing="0.04" />

            <TextView
                android:id="@+id/tv_phase_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Phase 4.5"
                android:textSize="11sp"
                android:textColor="@color/va_accent"
                android:background="@drawable/badge_accent_outline"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_build_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Build: --"
            android:textSize="11sp"
            android:textColor="@color/va_text_secondary"
            android:fontFamily="monospace"
            android:layout_marginBottom="20dp" />

        <!-- ── 权限状态卡片 ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_surface"
            android:padding="16dp"
            android:layout_marginBottom="10dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="PERMISSIONS"
                android:textSize="10sp"
                android:textColor="@color/va_text_secondary"
                android:letterSpacing="0.15"
                android:layout_marginBottom="12dp" />

            <!-- 无障碍服务 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <View
                    android:id="@+id/tv_accessibility_dot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/dot_red"
                    android:layout_marginEnd="10dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="无障碍服务"
                    android:textSize="14sp"
                    android:textColor="@color/va_text_primary" />

                <TextView
                    android:id="@+id/tv_accessibility_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="未开启"
                    android:textSize="13sp"
                    android:textColor="@color/va_red" />

                <TextView
                    android:id="@+id/btn_open_accessibility"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="  去开启"
                    android:textSize="12sp"
                    android:textColor="@color/va_accent"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- 屏幕录制 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <View
                    android:id="@+id/tv_capture_dot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/dot_red"
                    android:layout_marginEnd="10dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="屏幕录制"
                    android:textSize="14sp"
                    android:textColor="@color/va_text_primary" />

                <TextView
                    android:id="@+id/tv_screen_capture_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="未授权"
                    android:textSize="13sp"
                    android:textColor="@color/va_red" />

                <TextView
                    android:id="@+id/btn_request_screen_capture"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="  去授权"
                    android:textSize="12sp"
                    android:textColor="@color/va_accent" />
            </LinearLayout>
        </LinearLayout>

        <!-- ── 系统信息两列卡片 ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/card_surface"
                android:padding="12dp"
                android:layout_marginEnd="5dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="LOCAL ENGINE"
                    android:textSize="10sp"
                    android:textColor="@color/va_text_secondary"
                    android:letterSpacing="0.1"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tv_model_info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="MockVLM"
                    android:textSize="13sp"
                    android:textColor="@color/va_text_primary"
                    android:fontFamily="monospace"
                    android:layout_marginBottom="8dp" />

                <Button
                    android:id="@+id/btn_model_health_check"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:text="本地模型检查"
                    android:textSize="11sp"
                    android:textColor="@color/va_text_primary"
                    android:background="@drawable/input_bg" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/card_surface"
                android:padding="12dp"
                android:layout_marginStart="5dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="CLOUD API"
                    android:textSize="10sp"
                    android:textColor="@color/va_text_secondary"
                    android:letterSpacing="0.1"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tv_cloud_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textSize="13sp"
                    android:textColor="@color/va_green"
                    android:fontFamily="monospace" />
            </LinearLayout>
        </LinearLayout>

        <!-- ── Agent 状态卡片 ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_surface"
            android:padding="16dp"
            android:layout_marginBottom="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="AGENT STATUS"
                    android:textSize="10sp"
                    android:textColor="@color/va_text_secondary"
                    android:letterSpacing="0.15" />

                <TextView
                    android:id="@+id/tv_state"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="IDLE"
                    android:textSize="12sp"
                    android:textColor="@color/va_accent"
                    android:fontFamily="monospace"
                    android:background="@drawable/badge_accent_outline"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_execution_result"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="等待执行..."
                android:textSize="14sp"
                android:textColor="@color/va_text_primary"
                android:fontFamily="monospace"
                android:minLines="3"
                android:maxLines="5"
                android:ellipsize="end"
                android:background="@drawable/input_bg"
                android:padding="12dp"
                android:layout_marginBottom="10dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/va_divider"
                android:layout_marginBottom="10dp" />

            <TextView
                android:id="@+id/tv_last_response"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="上次响应: 无"
                android:textSize="12sp"
                android:textColor="@color/va_text_secondary"
                android:fontFamily="monospace"
                android:maxLines="5"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- ── 指令输入卡片 ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_surface"
            android:padding="16dp"
            android:layout_marginBottom="10dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="COMMAND INPUT"
                android:textSize="10sp"
                android:textColor="@color/va_text_secondary"
                android:letterSpacing="0.15"
                android:layout_marginBottom="10dp" />

            <EditText
                android:id="@+id/et_custom_prompt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="例如：打开相机"
                android:text="打开相机"
                android:minHeight="72dp"
                android:gravity="top|start"
                android:padding="12dp"
                android:background="@drawable/input_bg"
                android:textSize="15sp"
                android:textColor="@color/va_text_primary"
                android:textColorHint="@color/va_text_secondary"
                android:inputType="textMultiLine|textCapSentences"
                android:layout_marginBottom="10dp" />

            <Button
                android:id="@+id/btn_execute_custom"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="执 行 指 令"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:background="@drawable/button_primary"
                android:letterSpacing="0.1" />
        </LinearLayout>

        <!-- ── 快捷操作卡片 ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_surface"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="QUICK ACTIONS"
                android:textSize="10sp"
                android:textColor="@color/va_text_secondary"
                android:letterSpacing="0.15"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <Button
                    android:id="@+id/btn_test1"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="调高音量"
                    android:textSize="12sp"
                    android:textColor="@color/va_text_primary"
                    android:background="@drawable/input_bg"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/btn_test2"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="回到桌面"
                    android:textSize="12sp"
                    android:textColor="@color/va_text_primary"
                    android:background="@drawable/input_bg"
                    android:layout_marginStart="6dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <Button
                    android:id="@+id/btn_test3"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="打开相机"
                    android:textSize="12sp"
                    android:textColor="@color/va_text_primary"
                    android:background="@drawable/input_bg"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/btn_test4"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="WiFi设置"
                    android:textSize="12sp"
                    android:textColor="@color/va_text_primary"
                    android:background="@drawable/input_bg"
                    android:layout_marginStart="6dp" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_test5"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:text="打开微信"
                android:textSize="12sp"
                android:textColor="@color/va_text_primary"
                android:background="@drawable/input_bg" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
